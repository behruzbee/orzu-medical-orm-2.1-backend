# --- SERVER ---
PORT=3000

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=orzu_medical

# --- JWT ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- INTEGRATION API KEYS ---
# Use one or more comma-separated keys. Send the selected key in x-api-key.
INTEGRATION_API_KEYS=change-me-integration-key

# Backward-compatible legacy key name, still supported by ApiKeyGuard.
EXTERNAL_API_KEY=change-me-legacy-key

# --- LOCAL STORAGE ---
UPLOAD_PATH=./uploads
UPLOAD_URL=http://localhost:3000/uploads

# --- Trello API ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_NEW_COMPLAINTS=
TRELLO_LIST_ACCEPTED=
TRELLO_LIST_IN_PROGRESS=
TRELLO_LIST_UNRESOLVED=
TRELLO_LIST_RESOLVED=
TRELLO_LIST_COMPLETED=
TRELLO_LIST_SUGGESTIONS=
TRELLO_LIST_NOT_RELATED=
TRELLO_ADMIN_USERNAMES=
TRELLO_LIST_SUGGESTIONS_COPY=

# Public backend endpoint registered in Trello, for example:
# https://api.example.com/api/trello/webhook
TRELLO_WEBHOOK_URL=

# Copy a card when a position label is added. A key can be either a Trello
# label name or label ID. The short form reuses the main Trello credentials:
# TRELLO_POSITION_ROUTES={"Врач":"TARGET_LIST_ID","Старшая медсестра":"TARGET_LIST_ID"}
# For a board owned by another account, provide credentials per destination:
# TRELLO_POSITION_ROUTES={"Врач":{"targetListId":"TARGET_LIST_ID","apiKey":"TARGET_KEY","apiToken":"TARGET_TOKEN"}}
TRELLO_POSITION_ROUTES={}

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CHROME_BIN=
