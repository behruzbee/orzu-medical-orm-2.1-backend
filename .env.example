# --- SERVER ---
PORT=3000

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=orzu_medical

# --- JWT ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- INTEGRATION API KEYS ---
# Use one or more comma-separated keys. Send the selected key in x-api-key.
INTEGRATION_API_KEYS=change-me-integration-key

# Backward-compatible legacy key name, still supported by ApiKeyGuard.
EXTERNAL_API_KEY=change-me-legacy-key

# --- LOCAL STORAGE ---
UPLOAD_PATH=./uploads
UPLOAD_URL=http://localhost:3000/uploads

# --- Trello API ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
